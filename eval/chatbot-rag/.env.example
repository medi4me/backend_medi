# 평가 스크립트 실행에 필요한 환경변수 템플릿입니다.
# `cp .env.example .env` 로 복사한 뒤 실제 키를 채워 넣으세요.
# `.env` 는 gitignore 에 포함되어 있습니다.

OPENAI_API_KEY=

